# Frontend Configuration
# This file contains environment variables specific to the frontend deployment

# Image Flip Configuration
# Set to 'true' to flip captured images horizontally, 'false' to show normally
# Useful for mirror/selfie camera modes
FLIP_IMAGE=false

# API Endpoint Configuration
# URL to the backend API (if deployed separately)
# Example: https://api.example.com or http://localhost:5000
API_ENDPOINT=https://api.biswa.ca/predict

# Static Files Directory
# Path where frontend static files are served from
STATIC_DIR=./static

# Photo Storage Directory
# Path where captured photos and metadata are stored
PHOTOS_DIR=./photos
