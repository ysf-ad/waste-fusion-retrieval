# Raspberry Pi 5 with Camera and GPIO support
FROM python:3.11-slim-bookworm

# Install system dependencies for camera and GPIO
RUN apt-get update && apt-get upgrade -y && apt-get install -y \
    libcap-dev \
    libatlas-base-dev \
    ffmpeg \
    libopenjp2-7 \
    libcamera-dev \
    libkms++-dev \
    libfmt-dev \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements first for caching
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy static files and Python service
COPY static/ /app/static/
COPY pi_camera_service.py /app/

# Configuration via environment variables
ENV CAPTURE_DELAY=15
ENV MOTION_SENSOR_PIN=17
ENV API_ENDPOINT=https://api.biswa.ca/predict

# Expose port
EXPOSE 80

# Run the camera service
CMD ["python", "pi_camera_service.py"]
