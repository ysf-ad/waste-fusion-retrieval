# Raspberry Pi 5 with Camera and People Detection (YOLOv8)
FROM python:3.11-slim-bookworm

# Install system dependencies for camera and YOLOv8
RUN apt-get update && apt-get install -y \
    libcamera-dev \
    libcap-dev \
    python3-libcamera \
    python3-kms++ \
    python3-pyqt5 \
    python3-prctl \
    libatlas-base-dev \
    libjasper-dev \
    libtiff-dev \
    libjasper1 \
    ffmpeg \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements first for caching
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt && \
    python -c "from ultralytics import YOLO; YOLO('yolov8n.pt')"

# Copy static files and Python service
COPY static/ /app/static/
COPY pi_camera_service.py /app/

# Configuration via environment variables
ENV CAPTURE_DELAY=2
ENV DETECTION_COOLDOWN=10
ENV PEOPLE_DETECTION_THRESHOLD=0.5
ENV API_ENDPOINT=https://api.biswa.ca/predict

# Expose port
EXPOSE 80

# Run the camera service
CMD ["python", "pi_camera_service.py"]
